<odoo>
  <!-- Tree view -->
  <record id="view_allocation_tree" model="ir.ui.view">
    <field name="name">phieu.phan.bo.tree</field>
    <field name="model">asset.allocation</field>
    <field name="arch" type="xml">
      <tree string="Danh sách Phiếu phân bổ" decoration-muted="active==False">
        <field name="asset_id" string="Tài sản"/>
        <field name="employee_id" string="Nhân viên" />
        <field name="department_id" string="Phòng ban" />
        <field name="date_from" string="Ngày bắt đầu"/>
        <field name="date_to" string="Ngày kết thúc"/>
        <field name="active" string="Còn hiệu lực"/>
      </tree>
    </field>
  </record>

  <!-- Form view -->
  <record id="view_allocation_form" model="ir.ui.view">
    <field name="name">phieu.phan.bo.form</field>
    <field name="model">asset.allocation</field>
    <field name="arch" type="xml">
      <form string="Chi tiết Phiếu phân bổ">
        <sheet>
          <group string="Thông tin phân bổ">
            <field name="asset_id" string="Tài sản" required="1" options="{'no_create': True, 'no_edit': True}"/>
            <field name="employee_id" string="Nhân viên" options="{'no_create': True, 'no_edit': True}" />
            <field name="department_id" string="Phòng ban" options="{'no_create': True, 'no_edit': True}" />
          </group>
          <group string="Thời gian sử dụng">
            <field name="date_from" string="Ngày bắt đầu"/>
            <field name="date_to" string="Ngày kết thúc"/>
            <field name="active" string="Còn hiệu lực"/>
          </group>
          <group string="Khác">
            <field name="note" string="Ghi chú"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action + Menu -->
  <record id="action_asset_allocation" model="ir.actions.act_window">
    <field name="name">Phiếu phân bổ</field>
    <field name="res_model">asset.allocation</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'default_active': True}</field>
  </record>

  <menuitem id="menu_allocations"
            name="Phiếu phân bổ"
            parent="menu_asset_management"
            action="action_asset_allocation"
            sequence="20"/>
</odoo>
