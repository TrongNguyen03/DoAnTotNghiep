<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_purchase_request_tree" model="ir.ui.view">
        <field name="name">asset.purchase.request.tree</field>
        <field name="model">asset.purchase.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="requested_by"/>
                <field name="approved_by" />
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>


    <record id="view_asset_purchase_request_form" model="ir.ui.view">
        <field name="name">asset.purchase.request.form</field>
        <field name="model">asset.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Phiếu đề xuất mua tài sản">
                <sheet>
                    <field name="state" readonly="1" widget="statusbar"/>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="requested_by" readonly="1"/>
                        <field name="date"/>
                        <field name="reason"/>
                     </group>
                    <notebook>
                        <page string="Danh sách sản phẩm muốn mua">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_name" width="100%"/>
                                    <field name="category_id" width="100%"/>
                                    <field name="quantity" width="100%"/>
                                    <field name="unit_price" width="100%"/>
                                </tree>
                            </field>
                        </page>
                     </notebook>
                    <group>
                        <button string="Duyệt" type="object" name="action_confirm" states="draft" class="oe_highlight" groups="base.group_system,custom_views.group_asset_manager,custom_views.group_purchase_officer"/>
                        <button string="Đẩy phiếu mua" type="object" name="action_to_purchase" states="approved" class="oe_highlight" groups="base.group_system,custom_views.group_asset_manager,custom_views.group_purchase_officer"/>
                        <button string="Hủy" type="object" name="action_cancel" groups="base.group_system,custom_views.group_asset_manager,custom_views.group_purchase_officer"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_asset_purchase_request" model="ir.actions.act_window">
        <field name="name">Phiếu đề xuất</field>
        <field name="res_model">asset.purchase.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_asset_purchase_request_action" parent="menu_asset_purchase_request" action="action_asset_purchase_request"/>
</odoo>