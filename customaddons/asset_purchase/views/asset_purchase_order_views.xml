<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_purchase_order_tree" model="ir.ui.view">
        <field name="name">asset.purchase.order.tree</field>
        <field name="model">asset.purchase.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="origin_request_id"/>
                <field name="requested_by"/>
                <field name="date"/>
                <field name="state"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>

    <record id="view_asset_purchase_order_form" model="ir.ui.view">
        <field name="name">asset.purchase.order.form</field>
        <field name="model">asset.purchase.order</field>
        <field name="arch" type="xml">
            <form string="Phiếu mua tài sản">
                <sheet>
                    <field name="state" readonly="1" widget="statusbar"/>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="origin_request_id" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="requested_by" readonly="1"/>
                        <field name="date"/>
                        <field name="total_amount"  />
                    </group>
                    <notebook>
                        <page string="Danh sách sản phẩm muốn mua">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="product_name" width="100%"/>
                                <field name="category_id" width="100%"/>
                                <field name="quantity" width="100%"/>
                                <field name="unit_price" width="100%"/>
                                <field name="subtotal" width="100%"/>
                            </tree>
                        </field>
                        </page>
                    </notebook>
                    <group>
                        <button string="Xác nhận" type="object" name="action_confirm" states="draft" class="oe_highlight" groups="base.group_system,custom_views.group_asset_manager,custom_views.group_purchase_officer"/>
                        <button string="Đang đặt hàng" type="object" name="action_mark_to_receive" states="confirmed" class="oe_highlight" groups="base.group_system,custom_views.group_asset_manager,custom_views.group_purchase_officer"/>
                        <button string="Hàng đã đến" type="object" name="action_mark_done" states="to_receive" class="oe_highlight" groups="base.group_system,custom_views.group_asset_manager,custom_views.group_purchase_officer"/>
                        <button string="Hủy" type="object" name="action_cancel" groups="base.group_system,custom_views.group_asset_manager,custom_views.group_purchase_officer"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_purchase_order" model="ir.actions.act_window">
        <field name="name">Phiếu mua</field>
        <field name="res_model">asset.purchase.order</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_asset_purchase_order_action" parent="menu_asset_purchase_order" action="action_asset_purchase_order"/>
</odoo>