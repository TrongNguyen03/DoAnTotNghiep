<odoo>
    <!-- Kanban view -->
    <record id="view_asset_kanban" model="ir.ui.view">
        <field name="name">asset.asset.kanban</field>
        <field name="model">asset.asset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_example" >
                <field name="name"/>
                <field name="code"/>
                <field name="serial_number"/>
                <field name="state"/>
                <field name="employee_id"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click asset-kanban-card">
                            <strong>
                                <t t-esc="record.code.value"/>
                                -
                                <t t-esc="record.name.value"/>
                            </strong>
                            <div>
                                <strong>Số seri:</strong>
                                <t t-esc="record.serial_number.value or ''"/>
                            </div>
                            <div>
                                <strong>Loại tài sản:</strong>
                                <t t-esc="record.category_id.value or ''"/>
                            </div>
                            <div>
                                <strong>Nhân viên:</strong>
                                <t t-esc="record.employee_id.value or ''"/>
                            </div>
                            <div>
                                <strong>Trạng thái:</strong>
                                <t t-esc="record.state.value or ''"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree view -->
    <record id="view_asset_tree" model="ir.ui.view">
        <field name="name">asset.asset.tree</field>
        <field name="model">asset.asset</field>
        <field name="arch" type="xml">
            <tree string="Danh sách Tài sản" >
                <field name="name"/>
                <field name="code"/>
                <field name="serial_number"/>
                <field name="category_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="purchase_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_asset_form" model="ir.ui.view">
        <field name="name">asset.asset.form</field>
        <field name="model">asset.asset</field>
        <field name="arch" type="xml">
            <form string="Chi tiết Tài sản">
                <sheet>
                    <group string="Thông tin chung">
                        <field name="name"/>
                        <field name="code" readonly="1"/>
                        <field name="serial_number"/>
                        <field name="category_id"/>
                        <field name="state" widget="statusbar" readonly="1"/>
                    </group>
                    <group string="Phân bổ tài sản" invisible="1">
                        <field name="employee_id" invisible="1"/>
                        <field name="department_id" invisible="1"/>
                    </group>
                    <group string="Thông tin mua sắm">
                        <field name="purchase_date"/>
                        <field name="purchase_value"/>
                        <field name="warranty_end_date"/>
                    </group>
                    <notebook>
                        <page string="Ghi chú">
                            <field name="note" colspan="2"/>
                        </page>
                        <page string="Liên quan">
                            <group>
                                <field name="allocation_count" readonly="1"/>
                                <field name="maintenance_count" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Import Wizard -->

    <record id="view_asset_import_wizard" model="ir.ui.view">
        <field name="name">asset.import.wizard.form</field>
        <field name="model">asset.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Tài sản từ Excel" enctype="multipart/form-data">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <separator string="Hướng dẫn" colspan="2"/>
                <div class="o_form_label" colspan="2">
                    <ul>
                        <li>File Excel cần có các cột: Tên, Mã, Số seri, Loại, Nhân viên, Phòng ban, Ngày mua, Giá trị,
                            Hạn bảo hành, Trạng thái, Ghi chú.
                        </li>
                        <li>Hỗ trợ định dạng ngày: YYYY-MM-DD, DD/MM/YYYY, DD-MM-YYYY, YYYY/MM/DD</li>
                        <li>Nếu nhân viên hoặc phòng ban không tìm thấy, sẽ để trống và chuyển trạng thái 'Trong kho'.
                        </li>
                    </ul>
                </div>

                <footer>
                    <button string="Import" type="object" name="action_import" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_import" model="ir.actions.act_window">
        <field name="name">Import Tài sản</field>
        <field name="res_model">asset.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <!-- Actions -->

    <record id="action_asset_asset" model="ir.actions.act_window">
        <field name="name">Danh sách Tài sản</field>
        <field name="res_model">asset.asset</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có tài sản nào, hãy tạo mới hoặc import từ Excel!
            </p>
        </field>
    </record>

    <!-- Menus  -->

    <menuitem id="menu_asset_root" name="Quản lý Tài sản" sequence="10" web_icon="asset_core,static/description/icon.png"/>
    <menuitem id="menu_asset_management" name="Tài sản" parent="menu_asset_root" sequence="10"/>

    <!-- Danh sách -->
    <menuitem id="menu_assets" name="Danh sách Tài sản" parent="menu_asset_management"
              action="action_asset_asset" sequence="10" />

</odoo>
